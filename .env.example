# Ключ потрібен лише для режиму FAULTLOG_AI_MODE=live. Реальні ключі в Git не додаються.
OPENAI_API_KEY=

# Режим отримання пропозиції AI-компонента: live | scripted | unavailable
FAULTLOG_AI_MODE=scripted

# Модель для режиму live
FAULTLOG_AI_MODEL=gpt-4o-mini

# Файл локального сховища (окреме тестове сховище для кожного проходу)
FAULTLOG_STORAGE=data/faults.json

# Граничний час очікування відповіді AI-компонента, секунди
FAULTLOG_AI_TIMEOUT=30
